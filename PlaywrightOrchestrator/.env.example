# Base URL for tests
BASE_URL=https://example.com

# Playwright settings
HEADLESS=true
SLOW_MO=0
LOG_LEVEL=info

# Browser (chromium | firefox | webkit)
DEFAULT_BROWSER=chromium

# Parallel workers
WORKERS=4

# Report settings
REPORT_DIR=reports
REPORT_TITLE=Playwright Orchestrator Report

# AI Chat Agent (optional - extend AIChatAgent with your provider)
AI_API_KEY=
AI_MODEL=claude-sonnet-4-6

# API Testing
API_BASE_URL=https://api.example.com
API_TOKEN=

# Performance thresholds (ms)
PERF_LCP_THRESHOLD=2500
PERF_FCP_THRESHOLD=1800
PERF_TTI_THRESHOLD=3800

# Security
SECURITY_SCAN_DEPTH=basic
